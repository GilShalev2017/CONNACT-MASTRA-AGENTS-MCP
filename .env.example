# Copy this file to .env and fill in values before running `docker compose up`.
# docker-compose reads this file automatically from the project root.

# Required for the AI agent to actually generate answers. Without this,
# the app still runs (ingestion, CRM browsing, document upload all work),
# but /api/chat and the workflow/transcription analysis endpoints will
# fail when they try to call the LLM.
ANTHROPIC_API_KEY=

# Optional: override the Claude model used by every Mastra agent.
ANTHROPIC_MODEL=claude-sonnet-5
